+	depends on DRM_SUN4I
+	select DRM_KMS_HELPER
+	help
+	  Choose this option if you want to enable the composite video
+	  (CVBS) output of the AC200 chip co-packaged with the Allwinner H6.
+	  It is fed by the H6 TCON_LCD0 over a CCIR656 interface.
+	  If M is selected the module will be called sun50i_ac200_tve.
+
 config DRM_SUN8I_TCON_TOP
 	tristate
 	default DRM_SUN4I if DRM_SUN8I_MIXER!=n
