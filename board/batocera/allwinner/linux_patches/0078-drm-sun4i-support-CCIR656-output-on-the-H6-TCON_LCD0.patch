From d1bc4a86faf7eced832eb0e2b4ee6d71bc818145 Mon Sep 17 00:00:00 2001
From: Mr Slop Mizer <306584837+MrSlopster@users.noreply.github.com>
Date: Wed, 11 Nov 2026 17:48:21 +0400
Subject: [PATCH 78/82] drm/sun4i: support CCIR656 output on the H6 TCON_LCD0

Add the allwinner,sun50i-h6-tcon-lcd compatible and a CCIR656 (BT.656)
2-cycle output mode for TCON0, used to feed the TV encoder in the AC200
chip co-packaged with the H6. The mode is selected when the connector
reports MEDIA_BUS_FMT_UYVY8_2X8. Timings and the 54 MHz data clock
match what the Allwinner BSP programs for NTSC and PAL; the TCON's own
CSC converts the mixer's RGB output to YUV.

Also:
- sun8i_tcon_top: both mixer port selections reset to TCON_LCD0, and
  the other mixer takes precedence, so move it away when routing a
  mixer to a TCON it also selects.
- sun4i_rgb: propagate -EPROBE_DEFER from the panel/bridge lookup
  instead of silently disabling the output.
---
 drivers/gpu/drm/sun4i/sun4i_rgb.c      |  2 +
 drivers/gpu/drm/sun4i/sun4i_tcon.c     | 93 +++++++++++++++++++++++++-
 drivers/gpu/drm/sun4i/sun4i_tcon.h     |  7 ++
 drivers/gpu/drm/sun4i/sun8i_tcon_top.c | 14 ++++
 4 files changed, 115 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sun4i/sun4i_rgb.c b/drivers/gpu/drm/sun4i/sun4i_rgb.c
index dfb6acc42..d9a76c298 100644
--- a/drivers/gpu/drm/sun4i/sun4i_rgb.c
+++ b/drivers/gpu/drm/sun4i/sun4i_rgb.c
@@ -200,6 +200,8 @@ int sun4i_rgb_init(struct drm_device *drm, struct sun4i_tcon *tcon)
 
 	ret = drm_of_find_panel_or_bridge(tcon->dev->of_node, 1, 0,
 					  &rgb->panel, &rgb->bridge);
+	if (ret == -EPROBE_DEFER)
+		return ret;
 	if (ret) {
 		dev_info(drm->dev, "No panel or bridge found... RGB output disabled\n");
 		return 0;
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.c b/drivers/gpu/drm/sun4i/sun4i_tcon.c
index e39926e9f..d19d61d8c 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.c
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.c
@@ -595,6 +595,87 @@ static void sun4i_tcon0_mode_set_rgb(struct sun4i_tcon *tcon,
 	regmap_write(tcon->regs, SUN4I_TCON0_IO_TRI_REG, 0);
 }
 
+/*
+ * CCIR656 (BT.656) output on TCON0, as used by the H6 to feed the TV
+ * encoder in the co-packaged AC200. The mode is described to DRM as a
+ * progressive mode at twice the TV pixel clock (27 MHz), e.g. 720x480 with
+ * 858x525 totals for NTSC. Interlacing and the embedded sync codes are
+ * generated by the TCON itself; the register values below reproduce what
+ * the Allwinner BSP programs for PAL and NTSC.
+ */
+static void sun4i_tcon0_mode_set_ccir656(struct sun4i_tcon *tcon,
+					 const struct drm_display_mode *mode)
+{
+	u32 hbp, hsync, vbp, vsync, val;
+
+	WARN_ON(!tcon->quirks->has_channel_0);
+
+	/*
+	 * In CCIR656 2-cycle mode the TCON needs twice the (already doubled)
+	 * pixel clock: 54 MHz for both PAL and NTSC, as used by the BSP.
+	 */
+	tcon->dclk_min_div = tcon->quirks->dclk_min_div;
+	tcon->dclk_max_div = 127;
+	clk_set_rate(tcon->dclk, mode->clock * 1000 * 2);
+
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC0_REG,
+		     SUN4I_TCON0_BASIC0_X(mode->hdisplay) |
+		     SUN4I_TCON0_BASIC0_Y(mode->vdisplay));
+
+	/* Two clock cycles per pixel horizontally */
+	hbp = (mode->htotal - mode->hsync_start) * 2;
+	hsync = (mode->hsync_end - mode->hsync_start) * 2;
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC1_REG,
+		     SUN4I_TCON0_BASIC1_H_TOTAL(mode->htotal * 2) |
+		     SUN4I_TCON0_BASIC1_H_BACKPORCH(hbp));
+
+	/* Vertical timings are per field */
+	vbp = (mode->vtotal - mode->vsync_start) / 2;
+	vsync = (mode->vsync_end - mode->vsync_start) / 2;
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC2_REG,
+		     SUN4I_TCON0_BASIC2_V_TOTAL(mode->vtotal * 2) |
+		     SUN4I_TCON0_BASIC2_V_BACKPORCH(vbp));
+
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC3_REG,
+		     SUN4I_TCON0_BASIC3_V_SYNC(vsync) |
+		     SUN4I_TCON0_BASIC3_H_SYNC(hsync));
+
+	/*
+	 * HV interface in CCIR656 2-cycle mode. The field delay selects the
+	 * 625 (PAL) or 525 (NTSC) line format. The TCON's own CSC converts
+	 * the RGB coming from the mixer to YUV.
+	 */
+	val = SUN4I_TCON0_HV_IF_MODE_CCIR656_2CYC;
+	val |= (mode->vtotal == 625) ? SUN4I_TCON0_HV_IF_SYUV_FDLY_PAL :
+				       SUN4I_TCON0_HV_IF_SYUV_FDLY_NTSC;
+	regmap_write(tcon->regs, SUN4I_TCON0_HV_IF_REG, val);
+
+	regmap_update_bits(tcon->regs, SUN4I_TCON0_CTL_REG,
+			   SUN4I_TCON0_CTL_IF_MASK |
+			   SUN4I_TCON0_CTL_CLK_DELAY_MASK,
+			   SUN4I_TCON0_CTL_IF_HV |
+			   SUN4I_TCON0_CTL_CLK_DELAY(31));
+
+	regmap_write(tcon->regs, SUN4I_TCON0_IO_POL_REG, 0);
+
+	/* Map output pins to channel 0 */
+	regmap_update_bits(tcon->regs, SUN4I_TCON_GCTL_REG,
+			   SUN4I_TCON_GCTL_IOMAP_MASK,
+			   SUN4I_TCON_GCTL_IOMAP_TCON0);
+
+	/* Enable the output on the pins */
+	regmap_write(tcon->regs, SUN4I_TCON0_IO_TRI_REG, 0);
+}
+
+static bool sun4i_tcon_encoder_is_ccir656(const struct drm_encoder *encoder)
+{
+	struct drm_connector *connector = sun4i_tcon_get_connector(encoder);
+
+	return connector && connector->display_info.num_bus_formats &&
+	       connector->display_info.bus_formats[0] ==
+			MEDIA_BUS_FMT_UYVY8_2X8;
+}
+
 static void sun4i_tcon1_mode_set(struct sun4i_tcon *tcon,
 				 const struct drm_display_mode *mode)
 {
@@ -734,7 +815,10 @@ void sun4i_tcon_mode_set(struct sun4i_tcon *tcon,
 		sun4i_tcon0_mode_set_lvds(tcon, encoder, mode);
 		break;
 	case DRM_MODE_ENCODER_NONE:
-		sun4i_tcon0_mode_set_rgb(tcon, encoder, mode);
+		if (sun4i_tcon_encoder_is_ccir656(encoder))
+			sun4i_tcon0_mode_set_ccir656(tcon, mode);
+		else
+			sun4i_tcon0_mode_set_rgb(tcon, encoder, mode);
 		sun4i_tcon_set_mux(tcon, 0, encoder);
 		break;
 	case DRM_MODE_ENCODER_TVDAC:
@@ -1554,6 +1638,12 @@ static const struct sun4i_tcon_quirks sun20i_d1_lcd_quirks = {
 	.set_mux		= sun8i_r40_tcon_tv_set_mux,
 };
 
+static const struct sun4i_tcon_quirks sun50i_h6_lcd_quirks = {
+	.has_channel_0		= true,
+	.dclk_min_div		= 1,
+	.set_mux		= sun8i_r40_tcon_tv_set_mux,
+};
+
 /* sun4i_drv uses this list to check if a device node is a TCON */
 const struct of_device_id sun4i_tcon_of_table[] = {
 	{ .compatible = "allwinner,sun4i-a10-tcon", .data = &sun4i_a10_quirks },
@@ -1573,6 +1663,7 @@ const struct of_device_id sun4i_tcon_of_table[] = {
 	{ .compatible = "allwinner,sun9i-a80-tcon-tv", .data = &sun9i_a80_tcon_tv_quirks },
 	{ .compatible = "allwinner,sun20i-d1-tcon-lcd", .data = &sun20i_d1_lcd_quirks },
 	{ .compatible = "allwinner,sun20i-d1-tcon-tv", .data = &sun8i_r40_tv_quirks },
+	{ .compatible = "allwinner,sun50i-h6-tcon-lcd", .data = &sun50i_h6_lcd_quirks },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, sun4i_tcon_of_table);
diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.h b/drivers/gpu/drm/sun4i/sun4i_tcon.h
index fa23aa23f..1b15a7917 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.h
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.h
@@ -53,6 +53,7 @@
 #define SUN4I_TCON0_CTL_REG			0x40
 #define SUN4I_TCON0_CTL_TCON_ENABLE			BIT(31)
 #define SUN4I_TCON0_CTL_IF_MASK				GENMASK(25, 24)
+#define SUN4I_TCON0_CTL_IF_HV				(0 << 24)
 #define SUN4I_TCON0_CTL_IF_8080				(1 << 24)
 #define SUN4I_TCON0_CTL_CLK_DELAY_MASK			GENMASK(8, 4)
 #define SUN4I_TCON0_CTL_CLK_DELAY(delay)		((delay << 4) & SUN4I_TCON0_CTL_CLK_DELAY_MASK)
@@ -80,6 +81,12 @@
 #define SUN4I_TCON0_BASIC3_V_SYNC(height)		(((height) - 1) & 0x7ff)
 
 #define SUN4I_TCON0_HV_IF_REG			0x58
+#define SUN4I_TCON0_HV_IF_MODE_MASK			GENMASK(31, 28)
+#define SUN4I_TCON0_HV_IF_MODE_CCIR656_2CYC		(0xcU << 28)
+#define SUN4I_TCON0_HV_IF_SYUV_FDLY_MASK		GENMASK(21, 20)
+#define SUN4I_TCON0_HV_IF_SYUV_FDLY_PAL			(1 << 20)
+#define SUN4I_TCON0_HV_IF_SYUV_FDLY_NTSC		(2 << 20)
+#define SUN4I_TCON0_HV_IF_CCIR_CSC_DIS			BIT(19)
 
 #define SUN4I_TCON0_CPU_IF_REG			0x60
 #define SUN4I_TCON0_CPU_IF_MODE_MASK			GENMASK(31, 28)
diff --git a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
index a1ca3916f..c4d2d6e6a 100644
--- a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
+++ b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
@@ -85,6 +85,20 @@ int sun8i_tcon_top_de_config(struct device *dev, int mixer, int tcon)
 		reg &= ~TCON_TOP_PORT_DE1_MSK;
 		reg |= FIELD_PREP(TCON_TOP_PORT_DE1_MSK, tcon);
 	}
+
+	/*
+	 * Both fields reset to 0 (TCON_LCD0). If the other mixer still
+	 * selects the same TCON, it takes precedence and the TCON gets no
+	 * picture (seen on H6 with mixer0 -> TCON_LCD0). Move it out of the
+	 * way to a TCON that is not the one being configured.
+	 */
+	if (mixer == 0 && FIELD_GET(TCON_TOP_PORT_DE1_MSK, reg) == tcon) {
+		reg &= ~TCON_TOP_PORT_DE1_MSK;
+		reg |= FIELD_PREP(TCON_TOP_PORT_DE1_MSK, tcon == 2 ? 3 : 2);
+	} else if (mixer == 1 && FIELD_GET(TCON_TOP_PORT_DE0_MSK, reg) == tcon) {
+		reg &= ~TCON_TOP_PORT_DE0_MSK;
+		reg |= FIELD_PREP(TCON_TOP_PORT_DE0_MSK, tcon == 2 ? 3 : 2);
+	}
 	writel(reg, tcon_top->regs + TCON_TOP_PORT_SEL_REG);
 
 	spin_unlock_irqrestore(&tcon_top->reg_lock, flags);
-- 
2.56.0

